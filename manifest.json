{
  "manifest_version": 3,
  "name": "Nourish + Green Helper",
  "version": "0.3.0",
  "description": "Faster lunch picking on the Nourish + Green parent portal: a week planner with a pick-in-place drawer, favourites and hidden meals.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://portal.nourishandgreen.ie/*"
      ],
      "css": [
        "src/global.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://portal.nourishandgreen.ie/student/editstudentcart/*"
      ],
      "js": [
        "src/selectors.js",
        "src/storage.js",
        "src/meal-page.js"
      ],
      "css": [
        "src/meal-page.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portal.nourishandgreen.ie/student/editstudentcart/*"
      ],
      "js": [
        "src/page-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://portal.nourishandgreen.ie/dashboard*"
      ],
      "js": [
        "src/selectors.js",
        "src/storage.js",
        "src/portal.js",
        "src/planner.js"
      ],
      "css": [
        "src/planner.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "This week's lunches",
    "default_popup": "popup/popup.html"
  }
}
